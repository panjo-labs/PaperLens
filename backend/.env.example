# Copy to .env (never commit .env).
# NCBI asks API clients to identify themselves with a contact email.
NCBI_EMAIL=you@example.com
# Optional. Raises the NCBI rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Optional. Crossref contact email: moves requests to the faster "polite" pool (1 -> 3 req/s).
CROSSREF_MAILTO=
